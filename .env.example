# ════════════════════════════════════════════════════════════════
# Alongside 环境变量模板
#
#   用法：cp .env.example .env  然后逐项填真实值
#
#   ★ 铁律：本文件**只放变量名和占位符**。
#     任何真实密钥 / 账号密码都不许写进来，也不许写进代码。
#     .env 已被 .gitignore 忽略。
#   ★ 域名 / IP / 端口一律走这里，不许写死在代码里（主人要求"随时能换绑"）。
# ════════════════════════════════════════════════════════════════

# ── 运行环境 ──
APP_ENV=development
TZ=Asia/Shanghai
PORTS_MODE=unfiled

# ── 安全（部署时用 openssl rand -hex 32 生成）──
SECRET_KEY=<用 openssl rand -hex 32 生成>
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
ADMIN_PASSWORD_HASH=<argon2 哈希，不要存明文>
TOTP_SECRET=<TOTP 密钥>

# ── CORS ──
# 允许的来源，逗号分隔；`*` = 任意来源（此时按 CORS 规范强制不带凭据）
# 需要凭据型 CORS（cookie 级）时必须显式列出来源，如 https://life.example.com
CORS_ALLOW_ORIGINS=*

# ── 登录两步验证（TOTP）──
# true = 登录需密码 + 6 位动态码（默认）；false = 仅密码登录
TOTP_REQUIRED=true

# ── refresh cookie 的 Secure 属性（BUG-T30-1 修复，2026-09-20）──
# auto（默认）= 按请求 scheme 动态判定：https（含反代头 X-Forwarded-Proto: https）→
#   带 Secure；明文 http → 不带。上 HTTPS（T28/域名线）后无需改代码。
# true/false = 显式覆盖（优先于 scheme）。
# ★ 部署提示：直连 http（如 http://IP:PORT）的实例请显式设 false——
#   auto 在某些反代/内网穿透场景依赖转发头，显式值最可控；
#   明文 http 下若误开 Secure，浏览器会拒存 refresh cookie，30 分钟即被踢回登录页。
AUTH_COOKIE_SECURE=auto

# ── 数据 ──
DB_PATH=./data/alongside.db
BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=30

# ── 域名与端口 ──
DOMAIN=life.example.com
HTTP_PORT=8443
CF_API_TOKEN=<Cloudflare API Token>

# ── 本机笔记桥（跑在主人 Windows 上）──
BRIDGE_URL=http://127.0.0.1:8790
BRIDGE_PSK=<预共享密钥>

# ── 理财上游 BeeCount（T08B，只读 MCP）──
# 生产/本地测试同机约定：BASE 指向 BeeCount 根地址；MCP = {BASE}/api/v1/mcp
# PAT 只能打 MCP，不能打 REST；禁止把 token 写进代码/前端/git
FINANCE_UPSTREAM=mock
BEECOUNT_BASE_URL=http://127.0.0.1:8870
BEECOUNT_MCP_TOKEN=<bcmcp_...，仅写入 .env>

# ── 复盘上游 Work-Review（T09，只读）──
REVIEW_UPSTREAM=mock
WORK_REVIEW_BASE_URL=http://127.0.0.1:49996
WORK_REVIEW_TOKEN=<从本机 localhost_api_token.txt 读入 .env，勿入库>
WORK_REVIEW_BRIDGE=false

# ── 插件内呼 API（T17 diary → docs 跨插件走 HTTP，ADR-0002）──
# diary 后端经 httpx 调本服务 docs API；默认 http://127.0.0.1:18000（线上 uvicorn 端口）
INTERNAL_API_BASE=http://127.0.0.1:18000

# ── Web Push（push 插件：PWA 浏览器推送通道）──
# VAPID 密钥对（**必需**，缺则订阅必失败；桌面 Toast 走桥不受影响）。
# ★ 生成（**在项目根目录执行**，脚本会自动自验并把三键写入目标 .env）：
#     Windows 本地：services/api/.venv/Scripts/python.exe tools/gen_vapid_keys.py --write
#     生产 Linux  ：services/api/.venv/bin/python       tools/gen_vapid_keys.py --write
#   （只跑不加 --write = dry-run：只打印公钥，不动文件；私钥永不打印）
# ★ 格式（依据 py_vapid.Vapid.from_string 的解析规则，均 base64url、去 padding、**单行**）：
#     公钥 = 未压缩公钥点（65 字节 / 0x04 开头）—— 前端 applicationServerKey 要的正是这个形状
#     私钥 = 32 字节私钥标量
# 公钥经 /api/v1/push/vapid-public-key 下发前端（公钥本就该公开）；私钥只留服务端。
PUSH_VAPID_PUBLIC_KEY=<生成后填入>
PUSH_VAPID_PRIVATE_KEY=<生成后填入>
PUSH_VAPID_CLAIMS_EMAIL=mailto:admin@localhost

# ── 告警通道（可选）──
ALERT_WEBHOOK_URL=<告警 webhook>
