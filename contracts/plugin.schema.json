{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeos/contracts/plugin.schema.json",
  "title": "Alongside 插件清单（manifest）契约",
  "description": "总纲 §1.3.1 插件清单全部字段。任何插件（core / builtin / third-party）都必须满足本契约。内核用本文件强校验，错误精确到字段。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "kind",
    "kernelApi",
    "provides",
    "requires",
    "slots",
    "emits",
    "consumes",
    "permissions"
  ],
  "allOf": [
    {
      "description": "★ 路径 a：仅 container 型可省 api；其余 kind 必须声明 api。",
      "if": { "properties": { "kind": { "not": { "const": "container" } } } },
      "then": { "required": ["api"] }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "全局唯一，小写英文，等于目录名、等于 URL 前缀。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "界面显示的中文名。"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "三段式语义化版本。"
    },
    "kind": {
      "type": "string",
      "enum": ["core", "builtin", "third-party", "container"],
      "description": "core 不可禁用不可卸载；builtin 可禁用不可卸载；third-party 可禁用可卸载；container 为容器型模块（纯前端编排容器，如系统窗，可无 api 与 entry）。"
    },
    "minKernel": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "要求的最低内核版本。"
    },
    "kernelApi": {
      "type": "string",
      "pattern": "^\\^?\\d+(\\.\\d+)?(\\.\\d+)?$",
      "description": "要求的内核接口版本（如 ^1）。不兼容时明确拒绝加载，不许静默失败。"
    },
    "icon": {
      "type": "string",
      "description": "从内核图标表挑选的图标名。"
    },
    "description": {
      "type": "string",
      "description": "一句话描述（20 字内）。"
    },
    "author": {
      "type": "string"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer", "minimum": 240 },
        "h": { "type": "integer", "minimum": 200 },
        "minW": { "type": "integer", "minimum": 240 },
        "minH": { "type": "integer", "minimum": 200 },
        "singleton": { "type": "boolean" },
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    },
    "entry": {
      "type": "string",
      "description": "前端入口（内置插件约定 @/apps/<id>；内核按此动态加载窗口组件）。"
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base"],
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^/api/v1/[a-z][a-z0-9-]*$",
          "description": "路由前缀，必须等于 /api/v1/<id>。"
        },
        "openapi": { "type": "string" },
        "health": { "type": "string" },
        "tools": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^/" },
          "description": "ISSUE-008 方案 A：resource → 真实路由段 的显式映射（如 {\"entry\": \"/entries\"}）。键为 provides 倒数第二段；声明则 MCP 转发优先用它，未声明 resource 走机械「resource+s」推导。"
        }
      }
    },
    "tabs": {
      "type": "array",
      "description": "★ 路径 a：容器型模块（kind=container）的页签声明。一次定稿，形状与前端 SystemApp（70c0702）对接面一致：{key,label,entry?}。entry=模块 id（该页懒加载对应 App）；无 entry 的页 =「后端模块 · 仅服务」薄壳语义。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "description": "页签唯一键（容器内稳定标识）。" },
          "label": { "type": "string", "minLength": 1, "description": "页签显示名。" },
          "entry": {
            "type": "string",
            "description": "可选：该页关联的模块 id（懒加载对应 App）；省略则为「仅服务」薄壳页。"
          }
        }
      }
    },
    "provides": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$" },
      "description": "本插件对外提供的能力，格式 <id>.<名词>.<动作>（至少一段点分）。"
    },
    "requires": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$" },
      "description": "本插件需要别人提供的能力；没写的能力调用会被拒。"
    },
    "optionalDependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$" },
      "description": "软依赖：缺了不阻塞启动，O1 挂 degraded+reason_code。与 requires 互斥（同一条目不得两处都写）。"
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "desktop.dock",
          "desktop.dock-left",
          "desktop.dock-right",
          "desktop.widget",
          "dashboard.card",
          "topbar.action",
          "calendar.block.renderer",
          "calendar.overlay",
          "inspector.panel",
          "settings.page",
          "search.provider",
          "ai.tool",
          "notification.channel",
          "command.palette",
          "window.sidecar"
        ]
      },
      "description": "本插件要挂到的扩展点（只能从已知 14 个里挑；desktop.dock-left/right 为 U3 桌面级侧栏，window.sidecar 为 E5 窗口内测栏，附着目标用 attachTo 声明）。"
    },
    "emits": {
      "type": "array",
      "items": { "type": "string" },
      "description": "本插件会发出的事件，格式 <id>.<名词>.<过去式>。"
    },
    "consumes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "本插件会监听的事件。"
    },
    "permissions": {
      "oneOf": [
        {
          "type": "array",
          "items": { "type": "string" },
          "description": "【旧格式，向后兼容】权限字符串数组，如 [\"db:own\"]。新插件请用对象格式。"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "filesystem": { "type": "boolean", "default": false, "description": "允许访问本地文件系统" },
            "network": { "type": "boolean", "default": false, "description": "允许发起网络请求" },
            "subprocess": { "type": "boolean", "default": false, "description": "允许创建子进程" }
          },
          "required": [],
          "description": "【新格式】声明式权限：filesystem / network / subprocess，默认均为 false，需显式授权"
        }
      ],
      "description": "权限声明：支持旧数组格式（向后兼容）或新对象格式（声明式）。"
    },
    "activates_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(startup:always|event:[a-z0-9-]+(\\.[a-z0-9-]+)+)$"
      },
      "description": "声明式激活事件。缺省或含 startup:always = 启动即激活（向后兼容）；event:<topic> = 事件命中触发懒加载（精确匹配）；未命中则保持注册未激活。"
    },
    "migrations": {
      "type": ["string", "null"],
      "description": "自带迁移目录（相对插件根）。无表则写 null。"
    },
    "settingsSchema": {
      "type": ["string", "null"],
      "description": "设置 JSON Schema 路径；无设置则写 null。"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onInstall": { "type": ["string", "null"] },
        "onEnable": { "type": ["string", "null"] },
        "onDisable": { "type": ["string", "null"] },
        "onUninstall": { "type": ["string", "null"] }
      }
    }
  }
}
