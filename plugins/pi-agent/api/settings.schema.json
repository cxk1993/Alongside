{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pi 智能体设置",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "default": "alongside",
      "description": "模型提供商名（对应 models.json 里 providers 的 key）。★ 必须与 models.json 一致，否则报 Unknown provider"
    },
    "model": {
      "type": "string",
      "default": "alongside",
      "description": "模型 id（对应 models.json 里该 provider 的 models[].id）。★ 网关按此名路由，写错会 503「无可用的模型」"
    },
    "thinking_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "high"
    },
    "vision_fallback_model": {
      "type": "string",
      "default": "识图",
      "description": "纯视觉兜底路由"
    },
    "pi_binary": {
      "type": "string",
      "default": "pi",
      "description": "pi 可执行文件路径（PATH 或绝对路径）"
    },
    "max_parallel_sessions": {
      "type": "integer",
      "default": 4,
      "minimum": 1,
      "maximum": 16
    },
    "sandbox": {
      "type": "boolean",
      "default": false,
      "description": "沙箱模式：pi 跑在 Docker 容器里（Plain Docker 隔离，工具执行不出容器）"
    },
    "sandbox_image": {
      "type": "string",
      "default": "lifeos-pi-sandbox:0.87.1",
      "description": "沙箱镜像（版本 pin 死）"
    }
  },
  "additionalProperties": false
}
