{
  "id": "pi-agent",
  "name": "Pi 智能体",
  "version": "0.1.0",
  "kind": "third-party",
  "minKernel": "0.1.0",
  "kernelApi": "^1",
  "icon": "bot",
  "description": "接入 Pi 编码 agent（外部 CLI，独立安装）：AI 对话 + AI 编排。★ 会话池：一个 session = 一个 pi 子进程（外部 agent 可锁定/切换会话）。★ 经 ADR-0003 MCP 桥自动暴露 pi_chat_write / pi_session_read / pi_session_write。★ 对话 UI：流式 SSE + 会话切换 + L1/L2/L3 降级可见。",
  "author": "astrbot（云昔）",
  "window": {
    "w": 900,
    "h": 660,
    "minW": 520,
    "minH": 420,
    "singleton": false
  },
  "entry": "@/apps/pi-agent",
  "api": {
    "base": "/api/v1/pi-agent",
    "openapi": "/api/v1/pi-agent/openapi.json",
    "health": "/api/v1/pi-agent/health",
    "tools": {
      "chat": "/chat"
    }
  },
  "provides": [
    "pi.chat.write",
    "pi.session.read",
    "pi.session.write"
  ],
  "requires": [],
  "slots": [
    "desktop.dock",
    "settings.page"
  ],
  "emits": [
    "pi.session.started",
    "pi.session.settled",
    "pi.tool.called"
  ],
  "consumes": [],
  "permissions": [
    "fs:plugin",
    "net:out:localhost",
    "subprocess"
  ],
  "migrations": null,
  "settingsSchema": null,
  "lifecycle": {
    "onInstall": null,
    "onEnable": "on_enable",
    "onDisable": "on_disable",
    "onUninstall": "on_uninstall"
  }
}
