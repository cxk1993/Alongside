{
  "id": "agents",
  "name": "AI 编排",
  "version": "0.1.0",
  "kind": "builtin",
  "minKernel": "0.1.0",
  "kernelApi": "^1",
  "icon": "bot",
  "description": "AI 编排控制台 · 任务块分发（把一句话目标拆成任务块、派给 agent、实时看进度、收回报）。★ 第⑥刀：dispatch 支持 mode=\"pi\" —— 由内嵌 Pi agent 真执行。★ pi.chat.write 走软依赖（pi-agent 是可卸载的第三方插件；缺了则 pi 模式降级，其余模式照常）。",
  "author": "yunxi",
  "window": {
    "w": 980,
    "h": 680,
    "minW": 640,
    "minH": 480,
    "singleton": false
  },
  "entry": "@/apps/agents",
  "api": {
    "base": "/api/v1/agents",
    "openapi": "/api/v1/agents/openapi.json",
    "health": "/api/v1/agents/health",
    "tools": {
      "agent.patch": "/agents/{agent_id}",
      "agent.delete": "/agents/{agent_id}",
      "task.patch": "/tasks/{task_id}",
      "task.delete": "/tasks/{task_id}"
    }
  },
  "provides": [
    "agents.task.read",
    "agents.task.write",
    "agents.task.dispatch",
    "agents.task.report",
    "agents.agent.patch",
    "agents.agent.delete",
    "agents.task.patch",
    "agents.task.delete"
  ],
  "requires": [],
  "slots": [
    "dashboard.card"
  ],
  "emits": [
    "agents.task.created",
    "agents.task.updated",
    "agents.task.dispatched",
    "agents.task.done"
  ],
  "consumes": [],
  "permissions": [
    "db:own",
    "net:out:localhost"
  ],
  "migrations": "migrations",
  "settingsSchema": "settings.schema.json",
  "lifecycle": {
    "onInstall": null,
    "onEnable": null,
    "onDisable": null,
    "onUninstall": null
  },
  "optionalDependencies": [
    "pi.chat.write"
  ]
}
