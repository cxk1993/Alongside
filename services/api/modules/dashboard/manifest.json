{
  "id": "dashboard",
  "name": "今日总览",
  "version": "0.1.0",
  "kind": "builtin",
  "minKernel": "0.1.0",
  "kernelApi": "^1",
  "icon": "box",
  "description": "打开系统看到的第一屏：聚合今日/钱/复盘/模块健康（T11 最小闭环）",
  "author": "yunxi",
  "window": {
    "w": 960,
    "h": 680,
    "minW": 640,
    "minH": 480,
    "singleton": true
  },
  "entry": "@/apps/dashboard",
  "api": {
    "base": "/api/v1/dashboard",
    "openapi": "/api/v1/dashboard/openapi.json",
    "health": "/api/v1/dashboard/health",
    "tools": {
      "today": "/today",
      "system-health": "/health-of-system",
      "overview": "/overview"
    }
  },
  "provides": [
    "dashboard.overview.read",
    "dashboard.today.read",
    "dashboard.system-health.read"
  ],
  "requires": [
    "calendar.event.read",
    "todo.item.read",
    "habits.habit.read",
    "finance.snapshot.read",
    "finance.entry.read",
    "review.source.read",
    "plugin.list"
  ],
  "slots": [],
  "emits": [],
  "consumes": [
    "calendar.event.created",
    "calendar.event.updated",
    "calendar.event.deleted",
    "todo.item.created",
    "todo.item.updated",
    "todo.item.completed",
    "habits.habit.created",
    "habits.habit.updated",
    "habits.log.checked",
    "habits.log.unchecked",
    "finance.snapshot.updated",
    "review.day.ingested"
  ],
  "permissions": [
    "net:out:127.0.0.1",
    "net:out:localhost"
  ],
  "migrations": null,
  "settingsSchema": null
}
