{
  "id": "diary",
  "name": "日记",
  "version": "0.1.0",
  "kind": "builtin",
  "minKernel": "0.1.0",
  "kernelApi": "^1",
  "icon": "记",
  "description": "日记：按日期索引的文稿（文档树内核薄壳）。一天 = 路径 日记/{yyyy}/{mm}/{yyyy-mm-dd}，不建表。",
  "author": "yunxi",
  "window": {
    "w": 900,
    "h": 640,
    "minW": 560,
    "minH": 400
  },
  "entry": "@/apps/diary",
  "api": {
    "base": "/api/v1/diary",
    "openapi": "/api/v1/diary/openapi.json",
    "health": "/api/v1/diary/health",
    "tools": {
      "entry.patch": "/entry/{node_id}",
      "entry.delete": "/entry/{node_id}"
    }
  },
  "provides": [
    "x.summary.today",
    "diary.entry.patch",
    "diary.entry.delete"
  ],
  "requires": [
    "docs.node.read",
    "docs.node.write",
    "docs.search"
  ],
  "slots": [
    "desktop.dock",
    "dashboard.card",
    "desktop.dock-right"
  ],
  "emits": [],
  "consumes": [],
  "permissions": [],
  "migrations": null,
  "settingsSchema": "settings.schema.json"
}
