{
  "id": "docs",
  "name": "文档",
  "version": "0.1.0",
  "kind": "builtin",
  "minKernel": "0.1.0",
  "kernelApi": "^1",
  "icon": "box",
  "description": "文档树内核：通用文档树（树节点 + 正文 + 元数据 JSON + 版本历史 + FTS5 检索），供人格体系/日记等外壳零改动复用。",
  "author": "yunxi",
  "window": {
    "w": 720,
    "h": 520
  },
  "entry": "@/apps/docs",
  "api": {
    "base": "/api/v1/docs",
    "openapi": "/api/v1/docs/openapi.json",
    "health": "/api/v1/docs/health",
    "tools": {
      "content": "/content",
      "node.patch": "/nodes/{node_id}",
      "node.delete": "/nodes/{node_id}",
      "trash.delete": "/trash/{node_id}",
      "content.update": "/nodes/{node_id}/content"
    }
  },
  "provides": [
    "docs.node.read",
    "docs.node.write",
    "docs.node.patch",
    "docs.node.delete",
    "docs.search",
    "docs.content.write",
    "docs.trash.delete",
    "docs.content.update"
  ],
  "requires": [],
  "slots": [
    "desktop.dock",
    "dashboard.card",
    "search.provider"
  ],
  "emits": [
    "docs.node.created",
    "docs.node.updated",
    "docs.node.deleted",
    "docs.node.restored"
  ],
  "consumes": [],
  "permissions": [
    "db:own"
  ],
  "migrations": "migrations",
  "settingsSchema": "settings.schema.json",
  "lifecycle": {
    "onInstall": null,
    "onEnable": null,
    "onDisable": null,
    "onUninstall": null
  }
}
