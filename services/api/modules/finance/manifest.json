{
  "id": "finance",
  "name": "理财",
  "version": "0.2.0",
  "kind": "builtin",
  "minKernel": "0.1.0",
  "kernelApi": "^1",
  "icon": "box",
  "description": "个人账本 + BeeCount MCP 只读快照同步（金额整数分，date 幂等 upsert）。",
  "author": "yunxi",
  "window": {
    "w": 720,
    "h": 520
  },
  "entry": "@/apps/finance",
  "api": {
    "base": "/api/v1/finance",
    "openapi": "/api/v1/finance/openapi.json",
    "health": "/api/v1/finance/health",
    "tools": {
      "entry": "/entries",
      "beeccount": "/beecount/source",
      "entry.patch": "/entries/{entry_id}",
      "entry.delete": "/entries/{entry_id}"
    }
  },
  "provides": [
    "finance.entry.read",
    "finance.entry.write",
    "finance.snapshot.read",
    "finance.beeccount.read",
    "finance.entry.patch",
    "finance.entry.delete"
  ],
  "requires": [],
  "slots": [],
  "emits": [
    "finance.entry.created",
    "finance.entry.updated",
    "finance.entry.deleted",
    "finance.snapshot.updated"
  ],
  "consumes": [],
  "permissions": [
    "db:own",
    "net:out:127.0.0.1"
  ],
  "migrations": "migrations",
  "settingsSchema": "settings.schema.json",
  "tabs": [
    {
      "key": "beecount",
      "label": "账本（BeeCount）"
    },
    {
      "key": "local",
      "label": "本地流水"
    }
  ]
}
