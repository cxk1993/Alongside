{
  "id": "habits",
  "name": "习惯打卡",
  "version": "0.1.0",
  "kind": "builtin",
  "minKernel": "0.1.0",
  "kernelApi": "^1",
  "icon": "box",
  "description": "习惯打卡与连续天数追踪，支持休息日不破连击",
  "author": "yunxi",
  "window": {
    "w": 720,
    "h": 520,
    "minW": 420,
    "minH": 320,
    "singleton": false
  },
  "entry": "@/apps/habits",
  "api": {
    "base": "/api/v1/habits",
    "openapi": "/api/v1/habits/openapi.json",
    "health": "/api/v1/habits/health",
    "tools": {
      "habit": "/api/v1/habits",
      "log.write": "/{habit_id}/checkin",
      "habit.patch": "/{habit_id}",
      "habit.delete": "/{habit_id}",
      "log.delete": "/{habit_id}/checkin/{day}"
    }
  },
  "provides": [
    "habits.habit.read",
    "habits.habit.write",
    "habits.log.write",
    "habits.habit.patch",
    "habits.habit.delete",
    "habits.log.delete"
  ],
  "requires": [],
  "slots": [
    "dashboard.card"
  ],
  "emits": [
    "habits.habit.created",
    "habits.habit.updated",
    "habits.habit.deleted",
    "habits.log.checked",
    "habits.log.unchecked"
  ],
  "consumes": [],
  "permissions": [
    "db:own"
  ],
  "migrations": "migrations",
  "settingsSchema": "settings.schema.json"
}
