{
  "id": "mcp",
  "name": "MCP Server",
  "version": "0.1.0",
  "kind": "builtin",
  "minKernel": "0.1.0",
  "kernelApi": "^1",
  "icon": "box",
  "description": "MCP 桥（ADR-0003）：把各插件 manifest.provides 机械映射成 MCP tools 暴露给 AI 客户端。本插件自己不声明任何业务能力（provides 恒为空），工具完全由其他插件的 manifest 动态决定。",
  "author": "yunxi",
  "window": {
    "w": 860,
    "h": 560,
    "minW": 560,
    "minH": 400
  },
  "entry": "@/apps/mcp",
  "api": {
    "base": "/api/v1/mcp",
    "openapi": "/api/v1/mcp/openapi.json",
    "health": "/api/v1/mcp/health",
    "tools": {
      "pat.patch": "/pats/{pat_id}",
      "pat.delete": "/pats/{pat_id}"
    }
  },
  "provides": [
    "mcp.pat.patch",
    "mcp.pat.delete"
  ],
  "requires": [],
  "slots": [
    "settings.page"
  ],
  "emits": [],
  "consumes": [],
  "permissions": [
    "db:own"
  ],
  "migrations": "migrations",
  "settingsSchema": "settings.schema.json"
}
