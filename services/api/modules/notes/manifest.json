{
  "id": "notes",
  "name": "笔记",
  "version": "0.1.0",
  "kind": "builtin",
  "minKernel": "0.1.0",
  "kernelApi": "^1",
  "icon": "box",
  "description": "本机 Obsidian 笔记索引与搜索（全文经本机桥按需拉取，不进服务器库）",
  "author": "yunxi",
  "window": {
    "w": 720,
    "h": 520
  },
  "entry": "@/apps/notes",
  "api": {
    "base": "/api/v1/notes",
    "openapi": "/api/v1/notes/openapi.json",
    "health": "/api/v1/notes/health",
    "tools": {
      "note.update": "/notes/{note_id}",
      "note.delete": "/notes/{note_id}"
    }
  },
  "provides": [
    "notes.note.update",
    "notes.note.delete"
  ],
  "requires": [],
  "slots": [
    "dashboard.card"
  ],
  "emits": [
    "notes.lib.synced"
  ],
  "consumes": [],
  "permissions": [
    "db:own",
    "bridge:read"
  ],
  "migrations": "migrations",
  "settingsSchema": "settings.schema.json"
}
