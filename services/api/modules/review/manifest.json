{
  "id": "review",
  "name": "复盘",
  "version": "0.1.0",
  "kind": "builtin",
  "minKernel": "0.1.0",
  "kernelApi": "^1",
  "icon": "box",
  "description": "Work-Review 只读接入：日报落库、趋势对比、批注与原文回看",
  "author": "yunxi",
  "window": {
    "w": 860,
    "h": 600,
    "minW": 480,
    "minH": 360
  },
  "entry": "@/apps/review",
  "api": {
    "base": "/api/v1/review",
    "openapi": "/api/v1/review/openapi.json",
    "health": "/api/v1/review/health",
