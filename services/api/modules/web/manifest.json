{
  "id": "web",
  "name": "网页",
  "version": "0.1.0",
  "kind": "builtin",
  "minKernel": "0.1.0",
  "kernelApi": "^1",
  "icon": "globe",
  "description": "网页工作台：在 Alongside 里打开任意网页、固定成快捷入口，并为它声明 API/MCP 能力。这份「能力条目」是能力目录（T20）的输入端。",
  "author": "yunxi",
  "window": {
    "w": 1080,
    "h": 720
  },
  "entry": "@/apps/web",
  "api": {
    "base": "/api/v1/web",
    "openapi": "/api/v1/web/openapi.json",
    "health": "/api/v1/web/health",
    "tools": {
      "entry": "/entries",
      "entry.patch": "/entries/{entry_id}",
      "entry.delete": "/entries/{entry_id}"
    }
  },
  "provides": [
    "web.entry.read",
    "web.entry.write",
    "web.entry.patch",
    "web.entry.delete"
  ],
  "requires": [],
  "slots": [],
  "emits": [
    "web.entry.created",
    "web.entry.updated",
    "web.entry.deleted"
  ],
  "consumes": [],
  "permissions": [
    "db:own"
  ],
  "migrations": "api/migrations",
  "settingsSchema": "api/settings.schema.json",
  "lifecycle": {
    "onInstall": null,
    "onEnable": null,
    "onDisable": null,
    "onUninstall": null
  }
}
